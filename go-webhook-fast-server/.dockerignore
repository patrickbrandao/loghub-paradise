# Contexto de build da imagem (docker/Dockerfile).
# Mantem o contexto no minimo: so' o modulo Go entra.

.git
.gitignore
.DS_Store

# Dados de execucao local: ring.db, events.db, emergency/.
data/
*.db
*.db-wal
*.db-shm

# Documentacao e rascunhos nao participam do build.
docs/
tmp/
*.md

# Os arquivos compose mudam com frequencia; sem esta exclusao, editar um
# compose invalidaria o cache e forcaria um rebuild completo do Go.
docker/
!docker/Dockerfile
