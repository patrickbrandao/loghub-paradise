# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- log.level, log.access,
# log.access_sample -- ficam em conf/gelf.ini: edite o arquivo e mande
# `docker kill -s HUP gelf-nats`.
#
# Variaveis do go-gelf-server que este servidor nao tem (GELF_LISTEN_TLS,
# GELF_LISTEN_HTTPS, GELF_TLS_*, GELF_FILTER_*, GELF_RATELIMIT_*,
# GELF_SINK_TYPE, GELF_RING_MODE, GELF_SINK_NATS_TLS*, as de
# postgres/redis/sqlite/mysql/clickhouse...) nao fazem nada aqui; se chegarem
# ao container, o boot as nomeia num WARN. Elas nem chegam: o compose so'
# repassa as abaixo.

# ---------------------------------------------------------------- build/imagem
GELF_IMAGE=tmsoftbrasil/go-gelf-nats-server
GELF_IMAGE_TAG=dev
GELF_VERSION=dev
GELF_COMMIT=none
GELF_GO_VERSION=1.25
GELF_ALPINE_VERSION=3.22
GELF_NATS_IMAGE=nats:2.11-alpine
GELF_NATS_BOX_IMAGE=natsio/nats-box:0.20.0
GELF_FLUENT_BIT_IMAGE=fluent/fluent-bit:4.0.3

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope e o subject
# loghub.<space>.gelf. NAO e' o ambiente. Gramatica: segmentos de [a-z0-9-]
# separados por ponto, ate' 64 caracteres. O compose le GELF_WORKSPACE, nunca o
# WORKSPACE do shell: o Jenkins exporta WORKSPACE com o caminho do job.
# O stream de nats/stream.json cobre loghub.*.gelf: um space de VARIOS
# segmentos (acme.prod) exige um subject a mais nele, ou o boot sai com 3.
#GELF_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Defaults distintos dos compose do go-gelf-server e do go-gelf-pg-server, para
# rodarem no mesmo host. Para receber nas portas padrao do GELF, use
# GELF_PORT=12201 e GELF_HTTP_PORT=12202.
#GELF_PORT=12281
#GELF_HTTP_PORT=12282
#GELF_ADMIN_PORT=19281
#GELF_NATS_PORT=14291
#GELF_NATS_MONITOR_PORT=18291

# -------------------------------------------------------------- PROXY protocol
# No TCP e no HTTP, com um balanceador (ou terminador TLS) na frente.
#GELF_PROXY_PROTOCOL=optional
#GELF_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §16.3). Acima de ~169KiB, suba tambem o max_payload de
# nats/nats-server.conf: o boot sai com 3 se a maior mensagem nao couber
# (SPEC §3.9).
#GELF_CONVERT_MAX_MESSAGE_BYTES=128KiB
#GELF_CONVERT_KEEP_RAW=malformed
#GELF_CONVERT_ACCEPT_MALFORMED=true

# -------------------------------------------------------------------- memoria
# O GOMEMLIMIT precisa ser pelo menos o dobro de GELF_RING_MAX_BYTES, e o
# limite do container fica acima dele. Gramaticas diferentes: MEMORY_LIMIT e'
# do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
#GELF_GOMEMLIMIT=512MiB
#GELF_MEMORY_LIMIT=768M
#GELF_RING_MAX_BYTES=256MiB
#GELF_RING_CAPACITY_ITEMS=65536
#GELF_RING_HIGH_WATER=0.80

# ------------------------------------------------------------------------- UDP
# O teto real e' net.core.rmem_max do HOST (sysctl -w net.core.rmem_max=16777216).
#GELF_LISTEN_UDP_READ_BUFFER=8MiB
#GELF_LISTEN_UDP_LISTENERS=1
#GELF_LISTEN_UDP_REASSEMBLY_MAX_BYTES=64MiB
#GELF_LISTEN_UDP_REASSEMBLY_MAX_MESSAGES=16384

# ------------------------------------------------------------------------ HTTP
#GELF_HTTP_READ_HEADER_TIMEOUT=10s
#GELF_HTTP_READ_TIMEOUT=30s

# ------------------------------------------------------------------------ NATS
#GELF_SINK_WORKERS=8
#GELF_SINK_NATS_MODE=jetstream
#GELF_SINK_NATS_STREAM=LOGHUB_GELF
#LOGHUB_BEACON_INTERVAL=15
# A LOGHUB_EB_URL substitui as quatro chaves de conexao do docker-compose.yml:
# apague-as la' antes de definir esta (README, "LOGHUB_EB_URL"). So' nats://.
#LOGHUB_EB_URL=nats://usuario:senha@nats:4222

# --------------------------------------------------------------------- demo
#GELF_DEMO_INTERVAL=5

# ------------------------------------------------------------------ desligamento
#GELF_SHUTDOWN_PRE_STOP_DELAY=0s
#GELF_SHUTDOWN_DRAIN_TIMEOUT=30s
#GELF_LOG_FORMAT=json
