# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- filtro, rate-limit, log.level,
# log.access, log.access_sample, sink.sqlite.keep_files -- ficam em
# conf/gelf.ini: edite o arquivo e mande `docker kill -s HUP <container>`.
# Uma GELF_FILTER_* ou GELF_RATELIMIT_* posta aqui nao chega ao container.

# ---------------------------------------------------------------- build/imagem
GELF_IMAGE=go-gelf-server
GELF_IMAGE_TAG=local
GELF_VERSION=dev
GELF_COMMIT=none
GELF_GO_VERSION=1.25
GELF_ALPINE_VERSION=3.22
GELF_REDIS_IMAGE=redis:7.4-alpine
GELF_POSTGRES_IMAGE=postgres:18-alpine
GELF_MYSQL_IMAGE=mysql:8.4
GELF_NATS_IMAGE=nats:2.11-alpine
GELF_NATS_BOX_IMAGE=natsio/nats-box:0.20.0

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope e o subject
# loghub.<space>.gelf. NAO e' o ambiente. Trocar exige trocar os subjects de
# nats/stream.json (o boot recusa um stream que nao cobre o subject).
# Gramatica: segmentos de [a-z0-9-] separados por ponto, ate 64 caracteres.
# Fora de [a-z0-9.-] o go-loghub-ident sai com 111; um segmento vazio (a..b,
# .x, x.) passa na biblioteca e o servidor sai com 1 (README, "Identidade").
# O compose le GELF_WORKSPACE, nunca o WORKSPACE do shell: o Jenkins exporta
# WORKSPACE com o caminho do job, e ele viraria o space (saida 111).
#GELF_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Cada compose tem defaults distintos para que varias combinacoes rodem lado a
# lado; a de referencia (memory-nats) usa as portas GELF (12201 UDP+TCP, 12202
# HTTP, 12203 TLS, 12204 HTTPS) e 9104 no admin.
#GELF_PORT=12201
#GELF_HTTP_PORT=12202
#GELF_TLS_PORT=12203
#GELF_HTTPS_PORT=12204
#GELF_ADMIN_PORT=9104

# ------------------------------------------------------------------------- TLS
# Ponha server.crt e server.key em ./tls e ligue os listeners (TCP+TLS e HTTPS
# usam o mesmo certificado, SPEC §4.7).
#GELF_LISTEN_TLS=0.0.0.0:12203
#GELF_LISTEN_HTTPS=0.0.0.0:12204
#GELF_TLS_CLIENT_AUTH=optional
#GELF_TLS_CLIENT_CA=/etc/gelf/tls/clients-ca.crt

# -------------------------------------------------------------- PROXY protocol
#GELF_PROXY_PROTOCOL=optional
#GELF_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §3.5, §16.3). Replicas de um ring Redis compartilhado
# precisam de todas iguais.
# Teto do documento DESCOMPRIMIDO; acima dele, recusa contada (nunca trunca).
# O pior JLH e' 6 x isto + 8 KiB e precisa caber no max_payload do NATS
# (SPEC §3.9): acima de ~170 KiB, suba o max_payload de nats/nats-server.conf.
#GELF_CONVERT_MAX_MESSAGE_BYTES=128KiB
#GELF_CONVERT_KEEP_RAW=malformed
#GELF_CONVERT_ACCEPT_MALFORMED=true

# -------------------------------------------------------------------- memoria
# Com ring=memory o GOMEMLIMIT precisa ser pelo menos o dobro de
# GELF_RING_MAX_BYTES, e o limite do container fica acima dele. Gramaticas
# diferentes: MEMORY_LIMIT e' do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
#GELF_GOMEMLIMIT=512MiB
#GELF_MEMORY_LIMIT=768M
#GELF_RING_MAX_BYTES=256MiB

# ------------------------------------------------------------------------- UDP
# O teto real e' net.core.rmem_max do HOST (sysctl -w net.core.rmem_max=16777216).
#GELF_LISTEN_UDP_READ_BUFFER=8MiB
#GELF_LISTEN_UDP_LISTENERS=1
# Teto global da remontagem de chunks UDP (SPEC §5.2): bytes e mensagens abertas.
#GELF_LISTEN_UDP_REASSEMBLY_MAX_BYTES=64MiB
#GELF_LISTEN_UDP_REASSEMBLY_MAX_MESSAGES=16384

# ------------------------------------------------------------------------ HTTP
# Prazos e limites de conexao do POST /gelf (SPEC §4.5), para http e https.
#GELF_HTTP_READ_HEADER_TIMEOUT=10s
#GELF_HTTP_READ_TIMEOUT=30s
#GELF_HTTP_MAX_CONNS=0
#GELF_HTTP_MAX_CONNS_PER_IP=0

# ---------------------------------------------------------------- eventbus
# A URL do eventbus LogHub (SPEC §10.9), no lugar das chaves de conexao abaixo.
# So' chega ao container depois de editar o compose (nats, redis ou postgres):
# apagar as quatro linhas de conexao marcadas e descomentar a LOGHUB_EB_URL
# (README). Usuario e senha vao DENTRO da URL; as chaves donas
# (GELF_SINK_NATS_URLS/USERNAME/PASSWORD/TOKEN/TLS, GELF_SINK_REDIS_ADDRS/
# USERNAME/PASSWORD/DB/TLS, GELF_SINK_POSTGRES_ADDR/USERNAME/PASSWORD/
# DATABASE/TLS) nao podem estar definidas junto: o boot sai com 1.
#LOGHUB_EB_URL=nats://nats:4222

# ----------------------------------------------------------------------- nats
# USERNAME e PASSWORD so' chegam ao container quando definidas aqui, e COM
# valor: uma linha vazia ainda conta como explicita (e travaria o LOGHUB_EB_URL).
#GELF_SINK_NATS_USERNAME=
#GELF_SINK_NATS_PASSWORD=
#GELF_SINK_NATS_MODE=jetstream
#GELF_SINK_NATS_STREAM=LOGHUB_GELF
#LOGHUB_BEACON_INTERVAL=15

# ---------------------------------------------------------------------- redis
# USERNAME, PASSWORD e DB: como no nats, so' quando definidas aqui, com valor.
#GELF_SINK_REDIS_STREAM=loghub.{space}.gelf
#GELF_SINK_REDIS_USERNAME=
#GELF_SINK_REDIS_PASSWORD=

# ---------------------------------------------------------- postgres / mysql
# Valem para o servidor E para o servico de banco do compose, que cria o
# usuario com elas na primeira subida (depois disso, so' recriando o volume).
#GELF_SINK_POSTGRES_USERNAME=gelf
#GELF_SINK_POSTGRES_PASSWORD=gelf
#GELF_SINK_POSTGRES_DATABASE=gelf
# A fila LogHub (SPEC §3.7.1); docker/postgres/inbox.sql a cria na primeira subida.
#GELF_SINK_POSTGRES_TABLE=loghub.inbox
#GELF_SINK_MYSQL_PASSWORD=gelf
#GELF_MYSQL_ROOT_PASSWORD=root
# O pool padrao deriva sink.workers + 1 = 5 (os compose SQL fixam workers=4).
#GELF_SINK_POSTGRES_POOL_SIZE=0
#GELF_SINK_MYSQL_POOL_SIZE=0

# ----------------------------------------------------------------- clickhouse
# Valem para o servidor E para o servico clickhouse do compose, que cria o
# banco e o usuario com elas na primeira subida (depois disso, so' recriando o
# volume). O usuario precisa so' de INSERT e de um perfil com readonly = 0;
# async_insert e wait_for_async_insert sao do perfil dele, nao daqui
# (SPEC §10.10.6). 25.8+: o INSERT usa json_type_escape_dots_in_keys.
#GELF_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
#GELF_SINK_CLICKHOUSE_USERNAME=gelf
#GELF_SINK_CLICKHOUSE_PASSWORD=gelf
#GELF_SINK_CLICKHOUSE_DATABASE=gelf
# A tabela de docker/clickhouse/inbox_gelf.sql (SPEC §3.7.2), nao a inbox
# dos servidores de webhook. Trocar o nome aqui NAO muda o DDL nem o
# healthcheck do compose: crie a tabela a mao com o nome novo, ou o servidor
# sai com 3.
#GELF_SINK_CLICKHOUSE_TABLE=inbox_gelf
#GELF_SINK_CLICKHOUSE_POOL_SIZE=0
#GELF_CLICKHOUSE_PORT=9010

# ----------------------------------------------------------------- ring=none
# Escritas sincronas simultaneas. Vale para todo compose.none-*.yml: padrao
# 2048, e 5 nos de postgres/mysql/clickhouse, onde acompanha o pool -- acima dele o boot
# avisa e a fila fica escondida dentro do pool (SPEC §9.6).
#GELF_RING_MAX_INFLIGHT=2048

# ---------------------------------------------------------------- desligamento
# Aumentou? Aumente stop_grace_period em common.yml (precisa ser maior que a soma).
#GELF_SHUTDOWN_PRE_STOP_DELAY=0s
#GELF_SHUTDOWN_DRAIN_TIMEOUT=30s
