# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- filtro, rate-limit, log.level,
# log.access, log.access_sample, sink.sqlite.keep_files -- ficam em
# conf/syslog.ini: edite o arquivo e mande `docker kill -s HUP <container>`.
# Uma SYSLOG_FILTER_* ou SYSLOG_RATELIMIT_* posta aqui nao chega ao container.

# ---------------------------------------------------------------- build/imagem
SYSLOG_IMAGE=go-syslog-server
SYSLOG_IMAGE_TAG=local
SYSLOG_VERSION=dev
SYSLOG_COMMIT=none
SYSLOG_GO_VERSION=1.25
SYSLOG_ALPINE_VERSION=3.22
SYSLOG_REDIS_IMAGE=redis:7.4-alpine
SYSLOG_POSTGRES_IMAGE=postgres:18-alpine
SYSLOG_MYSQL_IMAGE=mysql:8.4
SYSLOG_NATS_IMAGE=nats:2.11-alpine
SYSLOG_NATS_BOX_IMAGE=natsio/nats-box:0.20.0

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope e o subject
# loghub.<space>.syslog. NAO e' o ambiente. Trocar exige trocar os subjects de
# nats/stream.json (o boot recusa um stream que nao cobre o subject).
# Gramatica: segmentos de [a-z0-9-] separados por ponto, ate 64 caracteres.
# Fora de [a-z0-9.-] o go-loghub-ident sai com 111; um segmento vazio (a..b,
# .x, x.) passa na biblioteca e o servidor sai com 1 (README, "Identidade").
# O compose le SYSLOG_WORKSPACE, nunca o WORKSPACE do shell: o Jenkins exporta
# WORKSPACE com o caminho do job, e ele viraria o space (saida 111).
#SYSLOG_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Cada compose tem defaults distintos para que varias combinacoes rodem lado a
# lado; a de referencia (memory-nats) usa 514 e 9102.
#SYSLOG_PORT=514
#SYSLOG_TLS_PORT=6514
#SYSLOG_ADMIN_PORT=9102

# ------------------------------------------------------------------------- TLS
# RFC 5425. Ponha server.crt e server.key em ./tls e ligue o listener.
#SYSLOG_LISTEN_TLS=0.0.0.0:6514
#SYSLOG_TLS_CLIENT_AUTH=optional
#SYSLOG_TLS_CLIENT_CA=/etc/syslog/tls/clients-ca.crt

# -------------------------------------------------------------- PROXY protocol
#SYSLOG_PROXY_PROTOCOL=optional
#SYSLOG_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §16.3). Nomes fixados pela skill loghub-type-syslog-schema.
#SYSLOG_MAX_MESSAGE_BYTES=64KiB
#SYSLOG_RFC3164_TIMEZONE=America/Sao_Paulo
#SYSLOG_PAYLOAD_RAW=true
#SYSLOG_LEGACY_CHARSET=cp1252
#SYSLOG_ACCEPT_MALFORMED=true
#SYSLOG_DEFAULT_PRIORITY=13
#SYSLOG_SD_MAX_ELEMENTS=32
#SYSLOG_SD_MAX_PARAMS=64

# -------------------------------------------------------------------- memoria
# Com ring=memory o GOMEMLIMIT precisa ser pelo menos o dobro de
# SYSLOG_RING_MAX_BYTES, e o limite do container fica acima dele. Gramaticas
# diferentes: MEMORY_LIMIT e' do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
#SYSLOG_GOMEMLIMIT=512MiB
#SYSLOG_MEMORY_LIMIT=768M
#SYSLOG_RING_MAX_BYTES=256MiB

# ------------------------------------------------------------------------- UDP
# O teto real e' net.core.rmem_max do HOST (sysctl -w net.core.rmem_max=16777216).
#SYSLOG_LISTEN_UDP_READ_BUFFER=8MiB
#SYSLOG_LISTEN_UDP_LISTENERS=1

# ---------------------------------------------------------------- eventbus
# A URL do eventbus LogHub (SPEC §10.9), no lugar das chaves de conexao abaixo.
# So' chega ao container depois de editar o compose (nats, redis ou postgres):
# apagar as quatro linhas de conexao marcadas e descomentar a LOGHUB_EB_URL
# (README). Usuario e senha vao DENTRO da URL; as chaves donas
# (SYSLOG_SINK_NATS_URLS/USERNAME/PASSWORD/TOKEN/TLS, SYSLOG_SINK_REDIS_ADDRS/
# USERNAME/PASSWORD/DB/TLS, SYSLOG_SINK_POSTGRES_ADDR/USERNAME/PASSWORD/
# DATABASE/TLS) nao podem estar definidas junto: o boot sai com 1.
#LOGHUB_EB_URL=nats://nats:4222

# ----------------------------------------------------------------------- nats
# USERNAME e PASSWORD so' chegam ao container quando definidas aqui, e COM
# valor: uma linha vazia ainda conta como explicita (e travaria o LOGHUB_EB_URL).
#SYSLOG_SINK_NATS_USERNAME=
#SYSLOG_SINK_NATS_PASSWORD=
#SYSLOG_SINK_NATS_MODE=jetstream
#SYSLOG_SINK_NATS_STREAM=LOGHUB_SYSLOG
#SYSLOG_SINK_NATS_SUBJECTS=exact
#LOGHUB_BEACON_INTERVAL=15

# ---------------------------------------------------------------------- redis
# USERNAME, PASSWORD e DB: como no nats, so' quando definidas aqui, com valor.
#SYSLOG_SINK_REDIS_STREAM=loghub.{space}.syslog
#SYSLOG_SINK_REDIS_USERNAME=
#SYSLOG_SINK_REDIS_PASSWORD=

# ---------------------------------------------------------- postgres / mysql
# Valem para o servidor E para o servico de banco do compose, que cria o
# usuario com elas na primeira subida (depois disso, so' recriando o volume).
#SYSLOG_SINK_POSTGRES_USERNAME=syslog
#SYSLOG_SINK_POSTGRES_PASSWORD=syslog
#SYSLOG_SINK_POSTGRES_DATABASE=syslog
# A fila LogHub (SPEC §3.7.1); docker/postgres/inbox.sql a cria na primeira subida.
#SYSLOG_SINK_POSTGRES_TABLE=loghub.inbox
#SYSLOG_SINK_MYSQL_PASSWORD=syslog
#SYSLOG_MYSQL_ROOT_PASSWORD=root
# O pool padrao deriva sink.workers + 1 = 5 (os compose SQL fixam workers=4).
#SYSLOG_SINK_POSTGRES_POOL_SIZE=0
#SYSLOG_SINK_MYSQL_POOL_SIZE=0

# ----------------------------------------------------------------- clickhouse
# Valem para o servidor E para o servico clickhouse do compose, que cria o
# banco e o usuario com elas na primeira subida (depois disso, so' recriando o
# volume). O usuario precisa so' de INSERT e de um perfil com readonly = 0;
# async_insert e wait_for_async_insert sao do perfil dele, nao daqui
# (SPEC §10.10.6). 25.8+: o INSERT usa json_type_escape_dots_in_keys.
#SYSLOG_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
#SYSLOG_SINK_CLICKHOUSE_USERNAME=syslog
#SYSLOG_SINK_CLICKHOUSE_PASSWORD=syslog
#SYSLOG_SINK_CLICKHOUSE_DATABASE=syslog
# A tabela de docker/clickhouse/inbox_syslog.sql (SPEC §3.7.2), nao a inbox
# dos servidores de webhook. Trocar o nome aqui NAO muda o DDL nem o
# healthcheck do compose: crie a tabela a mao com o nome novo, ou o servidor
# sai com 3.
#SYSLOG_SINK_CLICKHOUSE_TABLE=inbox_syslog
#SYSLOG_SINK_CLICKHOUSE_POOL_SIZE=0
#SYSLOG_CLICKHOUSE_PORT=9010

# ----------------------------------------------------------------- ring=none
# Escritas sincronas simultaneas. Vale para todo compose.none-*.yml: padrao
# 2048, e 5 nos de postgres/mysql/clickhouse, onde acompanha o pool -- acima dele o boot
# avisa e a fila fica escondida dentro do pool (SPEC §9.6).
#SYSLOG_RING_MAX_INFLIGHT=2048

# ---------------------------------------------------------------- desligamento
# Aumentou? Aumente stop_grace_period em common.yml (precisa ser maior que a soma).
#SYSLOG_SHUTDOWN_PRE_STOP_DELAY=0s
#SYSLOG_SHUTDOWN_DRAIN_TIMEOUT=30s
