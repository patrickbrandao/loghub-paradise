# Copie para .env e ajuste. O Compose le' .env automaticamente a partir do
# diretorio do primeiro arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem um default embutido no compose.

# ---------------------------------------------------------------- build/imagem
SYSLOG_IMAGE=go-syslog-server
SYSLOG_IMAGE_TAG=local
SYSLOG_VERSION=dev
SYSLOG_COMMIT=none
SYSLOG_GO_VERSION=1.25
SYSLOG_ALPINE_VERSION=3.22
SYSLOG_REDIS_IMAGE=redis:7.4-alpine
# 17 fixado: a imagem 18 mudou o diretorio de dados que os compose montam.
SYSLOG_POSTGRES_IMAGE=postgres:17-alpine
SYSLOG_MYSQL_IMAGE=mysql:8.4
SYSLOG_NATS_IMAGE=nats:2.11-alpine
SYSLOG_NATS_BOX_IMAGE=natsio/nats-box:0.20.0

# ------------------------------------------------------------------ exposicao
# Portas publicadas no host. Cada compose tem um default distinto para que varias
# combinacoes rodem lado a lado; a de referencia (memory-redis) usa 514.
#
# Publicar 514 no host NAO exige privilegio no container: quem abre a porta do
# host e' o daemon do Docker. Dentro do container a porta e' sempre 1514.
#SYSLOG_PORT=514
#SYSLOG_RELP_PORT=20514
# Admin -- sempre publicada apenas em 127.0.0.1 do host.
#SYSLOG_ADMIN_PORT=9102
#SYSLOG_REDIS_PORT=6379
#SYSLOG_POSTGRES_PORT=5432
#SYSLOG_MYSQL_PORT=3306
#SYSLOG_NATS_PORT=4222

# ----------------------------------------------------------------------- dados
# Nao existe knob de diretorio de dados aqui, de proposito. /data e' a unica area
# gravavel do container -- regra de TODA imagem do loghub-paradise, veja
# docs/SPEC.md 15.6. Para os dados irem parar em outro lugar do host, troque o
# VOLUME no compose da combinacao; o caminho DENTRO do container nao muda.

# -------------------------------------------------------------------- memoria
# SPEC §14.4: sem GOMEMLIMIT o GC do Go nao sabe do teto do container e o OOM
# killer chega antes do GC. common.yml define os dois; o limite do container
# precisa ficar ACIMA do GOMEMLIMIT, e com ring=memory o GOMEMLIMIT precisa ser
# pelo menos o dobro de SYSLOG_RING_MAX_BYTES (256MiB nos compose de memoria).
# Suba os tres juntos. Gramaticas diferentes: MEMORY_LIMIT e' do Compose (768M);
# GOMEMLIMIT e' do Go e aceita so' inteiro com B/KiB/MiB/GiB/TiB (maiusculas
# importam) ou off -- 768M derruba o processo antes do boot.
#SYSLOG_GOMEMLIMIT=512MiB
#SYSLOG_MEMORY_LIMIT=768M
#SYSLOG_RING_MAX_BYTES=256MiB

# ---------------------------------------------------------------------- filtro
# Recarregavel sem reiniciar: docker kill -s HUP <container>.
# Severidade MENOR e' MAIS grave: "warning" mantem emerg..warning e corta
# notice, info e debug.
#SYSLOG_FILTER_MIN_SEVERITY=debug
#SYSLOG_FILTER_FACILITIES=local0,local1,auth

# ------------------------------------------------------------------ rate limit
# A chave e' o IP de quem enviou, sempre. Atras de um relay unico (um rsyslog
# central, um balanceador L4 sem PROXY protocol) todo o trafego tem o mesmo IP e
# um limitador vira auto-DoS. Ligue so' com emissores chegando direto.
#SYSLOG_RATELIMIT_ENABLED=true
#SYSLOG_RATELIMIT_RATE=1000
#SYSLOG_RATELIMIT_BURST=2000

# ------------------------------------------------------------------------- UDP
# O parametro mais importante do transporte. Dentro do container o teto e'
# net.core.rmem_max do HOST; suba-o la' (sysctl -w net.core.rmem_max=16777216)
# ou este valor e' reduzido em silencio pelo kernel e o boot avisa.
#SYSLOG_LISTEN_UDP_READ_BUFFER=8MiB
#SYSLOG_LISTEN_UDP_LISTENERS=1

# ---------------------------------------------------------------------- redis
#SYSLOG_SINK_REDIS_STREAM=syslog:in
#SYSLOG_SINK_REDIS_DB=0
#SYSLOG_SINK_REDIS_USERNAME=
#SYSLOG_SINK_REDIS_PASSWORD=

# ------------------------------------------------------------------- postgres
# Os tres compose.*-postgres.yml usam estes valores nos DOIS lados: para criar o
# banco na imagem oficial e para o servidor se conectar. A senha padrao e' de
# desenvolvimento.
#SYSLOG_SINK_POSTGRES_USERNAME=syslog
#SYSLOG_SINK_POSTGRES_PASSWORD=syslog
#SYSLOG_SINK_POSTGRES_DATABASE=syslog
#SYSLOG_SINK_POSTGRES_TABLE=events
#SYSLOG_SINK_POSTGRES_POOL_SIZE=0

# ---------------------------------------------------------------------- mysql
# Os tres compose.*-mysql.yml usam estes valores nos DOIS lados: para criar o
# banco e o usuario na imagem oficial e para o servidor se conectar. As senhas
# padrao sao de desenvolvimento.
#SYSLOG_MYSQL_ROOT_PASSWORD=root
#SYSLOG_SINK_MYSQL_USERNAME=syslog
#SYSLOG_SINK_MYSQL_PASSWORD=syslog
#SYSLOG_SINK_MYSQL_DATABASE=syslog
#SYSLOG_SINK_MYSQL_TABLE=events
#SYSLOG_SINK_MYSQL_POOL_SIZE=0

# ----------------------------------------------------------------------- nats
# O stream e' criado pelo nats-init a partir de nats/stream.json; trocar o nome
# aqui exige trocar os subjects la'.
#SYSLOG_SINK_NATS_STREAM=SYSLOG
#SYSLOG_SINK_NATS_SUBJECT=syslog.in
# Os compose de NATS baixam os frames para 1 MiB: o maior evento (sete vezes o
# frame, docs/SPEC.md 3.9) precisa caber nos 8 MB de max_payload. Os outros
# compose seguem com 16MiB. Definir SYSLOG_TCP_MAX_FRAME_BYTES aqui vale para
# TODOS, e com NATS acima de ~1MiB o boot sai com codigo 3.
#SYSLOG_RELP_MAX_FRAME_BYTES=1MiB

# --------------------------------------------------------------------- sqlite
#SYSLOG_SINK_SQLITE_ROTATE=daily
#SYSLOG_SINK_SQLITE_KEEP_FILES=0

# ---------------------------------------------------------------- desligamento
# Se aumentar qualquer um, aumente stop_grace_period em common.yml: ele precisa
# ser MAIOR que a soma, ou o Docker mata o processo no meio do dreno.
#SYSLOG_SHUTDOWN_PRE_STOP_DELAY=0s
#SYSLOG_SHUTDOWN_DRAIN_TIMEOUT=30s
