# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- filtro, rate-limit, log.level,
# log.access, log.access_sample, sink.sqlite.keep_files -- ficam em
# conf/relplog.ini: edite o arquivo e mande `docker kill -s HUP <container>`.
# Uma RELPLOG_FILTER_* ou RELPLOG_RATELIMIT_* posta aqui nao chega ao container.

# ---------------------------------------------------------------- build/imagem
RELPLOG_IMAGE=go-relplog-server
RELPLOG_IMAGE_TAG=local
RELPLOG_VERSION=dev
RELPLOG_COMMIT=none
RELPLOG_GO_VERSION=1.25
RELPLOG_ALPINE_VERSION=3.22
RELPLOG_REDIS_IMAGE=redis:7.4-alpine
RELPLOG_POSTGRES_IMAGE=postgres:18-alpine
RELPLOG_MYSQL_IMAGE=mysql:8.4
RELPLOG_NATS_IMAGE=nats:2.11-alpine
RELPLOG_NATS_BOX_IMAGE=natsio/nats-box:0.20.0

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope e o subject
# loghub.<space>.syslog. NAO e' o ambiente. Trocar exige trocar os subjects de
# nats/stream.json (o boot recusa um stream que nao cobre o subject).
# Gramatica: segmentos de [a-z0-9-] separados por ponto, ate 64 caracteres.
# Fora de [a-z0-9.-] o go-loghub-ident sai com 111; um segmento vazio (a..b,
# .x, x.) passa na biblioteca e o servidor sai com 1 (README, "Identidade").
# O compose le RELPLOG_WORKSPACE, nunca o WORKSPACE do shell: o Jenkins exporta
# WORKSPACE com o caminho do job, e ele viraria o space (saida 111).
#RELPLOG_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Cada compose tem defaults distintos (RELP 20514+n, RELP/TLS 20614+n, admin
# 9300+n; tabela no README, "Portas") para que varias combinacoes rodem lado a
# lado, e ao lado do go-syslog-server. Definir aqui vale para TODO compose que
# subir com este .env: duas combinacoes de pe' passariam a disputar a porta.
#RELPLOG_PORT=20514
#RELPLOG_TLS_PORT=20614
#RELPLOG_ADMIN_PORT=9300

# --------------------------------------------------------------------- RELP/TLS
# Ponha server.crt e server.key em ./tls (tls/README.md) e ligue o listener.
#RELPLOG_LISTEN_TLS=0.0.0.0:20515
#RELPLOG_TLS_CLIENT_AUTH=optional
#RELPLOG_TLS_CLIENT_CA=/etc/relplog/tls/clients-ca.crt

# ------------------------------------------------------------ protocolo RELP
# SPEC §5. backpressure_timeout fica ABAIXO do `timeout` do omrelp (90 s).
#RELPLOG_RELP_WINDOW=128
#RELPLOG_RELP_MAX_FRAME_BYTES=16MiB
#RELPLOG_RELP_INFLIGHT_MAX_BYTES=64MiB
#RELPLOG_RELP_BACKPRESSURE_TIMEOUT=30s
#RELPLOG_TCP_IDLE_TIMEOUT=120s
#RELPLOG_TLS_IDLE_TIMEOUT=120s
#RELPLOG_TCP_MAX_CONNS=0
#RELPLOG_TLS_MAX_CONNS=0

# -------------------------------------------------------------- PROXY protocol
#RELPLOG_PROXY_PROTOCOL=optional
#RELPLOG_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §16.3). Nomes fixados pela skill loghub-type-syslog-schema,
# os mesmos do go-syslog-server: um .env comum garante a mesma conversao.
#SYSLOG_MAX_MESSAGE_BYTES=64KiB
#SYSLOG_RFC3164_TIMEZONE=America/Sao_Paulo
#SYSLOG_PAYLOAD_RAW=true
#SYSLOG_LEGACY_CHARSET=cp1252
#SYSLOG_ACCEPT_MALFORMED=true
#SYSLOG_DEFAULT_PRIORITY=13
#SYSLOG_SD_MAX_ELEMENTS=32
#SYSLOG_SD_MAX_PARAMS=64

# -------------------------------------------------------------------- memoria
# Com ring=memory o GOMEMLIMIT precisa ser pelo menos o dobro de
# RELPLOG_RING_MAX_BYTES, e o limite do container fica acima dele. Gramaticas
# diferentes: MEMORY_LIMIT e' do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
# relp.inflight_max_bytes (64MiB) soma fora do ring (SPEC §15.3a).
#RELPLOG_GOMEMLIMIT=512MiB
#RELPLOG_MEMORY_LIMIT=768M
#RELPLOG_RING_MAX_BYTES=256MiB

# ---------------------------------------------------------------- eventbus
# A URL do eventbus LogHub (SPEC §10.9), no lugar das chaves de conexao abaixo.
# So' chega ao container depois de editar o compose (nats, redis ou postgres):
# apagar as quatro linhas de conexao marcadas e descomentar a LOGHUB_EB_URL
# (README). Usuario e senha vao DENTRO da URL; as chaves donas
# (RELPLOG_SINK_NATS_URLS/USERNAME/PASSWORD/TOKEN/TLS, RELPLOG_SINK_REDIS_ADDRS/
# USERNAME/PASSWORD/DB/TLS, RELPLOG_SINK_POSTGRES_ADDR/USERNAME/PASSWORD/
# DATABASE/TLS) nao podem estar definidas junto: o boot sai com 1.
#LOGHUB_EB_URL=nats://nats:4222

# ----------------------------------------------------------------------- nats
# USERNAME e PASSWORD so' chegam ao container quando definidas aqui, e COM
# valor: uma linha vazia ainda conta como explicita (e travaria o LOGHUB_EB_URL).
#RELPLOG_SINK_NATS_USERNAME=
#RELPLOG_SINK_NATS_PASSWORD=
#RELPLOG_SINK_NATS_MODE=jetstream
#RELPLOG_SINK_NATS_STREAM=LOGHUB_SYSLOG
#RELPLOG_SINK_NATS_SUBJECTS=exact
#LOGHUB_BEACON_INTERVAL=15

# ---------------------------------------------------------------------- redis
# USERNAME, PASSWORD e DB: como no nats, so' quando definidas aqui, com valor.
#RELPLOG_SINK_REDIS_STREAM=loghub.{space}.syslog
#RELPLOG_SINK_REDIS_USERNAME=
#RELPLOG_SINK_REDIS_PASSWORD=
# Ring Redis (compose.redis-*.yml): nomes proprios, distintos dos do
# go-syslog-server (syslog:ring), para os dois poderem dividir um Redis.
#RELPLOG_RING_REDIS_STREAM=relplog:ring
#RELPLOG_RING_REDIS_GROUP=relplog-ring

# ---------------------------------------------------------- postgres / mysql
# Valem para o servidor E para o servico de banco do compose, que cria o
# usuario com elas na primeira subida (depois disso, so' recriando o volume).
#RELPLOG_SINK_POSTGRES_USERNAME=syslog
#RELPLOG_SINK_POSTGRES_PASSWORD=syslog
#RELPLOG_SINK_POSTGRES_DATABASE=syslog
# A fila LogHub (SPEC §3.7.1); docker/postgres/inbox.sql a cria na primeira subida.
#RELPLOG_SINK_POSTGRES_TABLE=loghub.inbox
#RELPLOG_SINK_MYSQL_PASSWORD=syslog
#RELPLOG_MYSQL_ROOT_PASSWORD=root
# O pool padrao deriva sink.workers = 4 (os compose SQL fixam workers=4; a sonda de saude tem conexao propria).
#RELPLOG_SINK_POSTGRES_POOL_SIZE=0
#RELPLOG_SINK_MYSQL_POOL_SIZE=0

# ----------------------------------------------------------------- clickhouse
# Valem para o servidor E para o servico clickhouse do compose, que cria o
# banco e o usuario com elas na primeira subida (depois disso, so' recriando o
# volume). O usuario precisa so' de INSERT e de um perfil com readonly = 0;
# async_insert e wait_for_async_insert sao do perfil dele, nao daqui
# (SPEC §10.10.6). 25.8+: o INSERT usa json_type_escape_dots_in_keys.
#RELPLOG_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
#RELPLOG_SINK_CLICKHOUSE_USERNAME=syslog
#RELPLOG_SINK_CLICKHOUSE_PASSWORD=syslog
#RELPLOG_SINK_CLICKHOUSE_DATABASE=syslog
# A tabela de docker/clickhouse/inbox_syslog.sql (SPEC §3.7.2), nao a inbox
# dos servidores de webhook. Trocar o nome aqui NAO muda o DDL nem o
# healthcheck do compose: crie a tabela a mao com o nome novo, ou o servidor
# sai com 3.
#RELPLOG_SINK_CLICKHOUSE_TABLE=inbox_syslog
#RELPLOG_SINK_CLICKHOUSE_POOL_SIZE=0

# ----------------------------------------------------------------- ring=none
# Escritas sincronas simultaneas. Vale para todo compose.none-*.yml: padrao
# 2048, e 5 nos de postgres/mysql/clickhouse, onde acompanha o pool -- acima
# dele o boot avisa e a fila fica escondida dentro do pool (SPEC §9.6).
#RELPLOG_RING_MAX_INFLIGHT=2048

# ---------------------------------------------------------------- desligamento
# Aumentou? Aumente stop_grace_period em common.yml: precisa ser MAIOR que
# pre_stop_delay + drain_timeout + 6 s (closeGrace das sessoes RELP, SPEC §5.8).
#RELPLOG_SHUTDOWN_PRE_STOP_DELAY=0s
#RELPLOG_SHUTDOWN_DRAIN_TIMEOUT=30s

# ------------------------------------------------- emissor de demonstracao
# compose.emitter.yml (profile demo). A porta e' a do CONTAINER do servidor.
#RELPLOG_DEMO_TARGET=relplog
#RELPLOG_DEMO_PORT=20514
#RELPLOG_DEMO_BURST=100
#RELPLOG_DEMO_INTERVAL=1
#RELPLOG_DEMO_TAG=rls-demo
