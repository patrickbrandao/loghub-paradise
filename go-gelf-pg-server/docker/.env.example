# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- log.level, log.access,
# log.access_sample -- ficam em conf/gelf.ini: edite o arquivo e mande
# `docker kill -s HUP gelf-pg`.
#
# Variaveis do go-gelf-server que este servidor nao tem (GELF_LISTEN_TLS,
# GELF_LISTEN_HTTPS, GELF_TLS_*, GELF_FILTER_*, GELF_RATELIMIT_*,
# GELF_SINK_TYPE, GELF_RING_MODE, as de nats/redis/sqlite/mysql/clickhouse,
# LOGHUB_BEACON_INTERVAL...) nao fazem nada aqui; se chegarem ao container, o
# boot as nomeia num WARN. Elas nem chegam: o compose so' repassa as abaixo.

# ---------------------------------------------------------------- build/imagem
GELF_IMAGE=tmsoftbrasil/go-gelf-pg-server
GELF_IMAGE_TAG=dev
GELF_VERSION=dev
GELF_COMMIT=none
GELF_GO_VERSION=1.25
GELF_ALPINE_VERSION=3.22
GELF_POSTGRES_IMAGE=postgres:18-alpine

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope (coluna space da fila).
# NAO e' o ambiente. Gramatica: segmentos de [a-z0-9-] separados por ponto, ate
# 64 caracteres. Fora de [a-z0-9.-] o go-loghub-ident sai com 111; um segmento
# vazio (a..b, .x, x.) passa na biblioteca e o servidor sai com 1. O compose
# le GELF_WORKSPACE, nunca o WORKSPACE do shell: o Jenkins exporta WORKSPACE
# com o caminho do job, e ele viraria o space (111).
#GELF_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Defaults distintos dos compose do go-gelf-server, para os dois rodarem no
# mesmo host. Para receber nas portas GELF padrao, use GELF_PORT=12201 e
# GELF_HTTP_PORT=12202.
#GELF_PORT=12301
#GELF_HTTP_PORT=12302
#GELF_ADMIN_PORT=19304
#GELF_POSTGRES_PORT=15494

# -------------------------------------------------------------- PROXY protocol
# No TCP e no HTTP, com um balanceador (ou terminador TLS) na frente.
#GELF_PROXY_PROTOCOL=optional
#GELF_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §3.5, §16.3).
#GELF_CONVERT_MAX_MESSAGE_BYTES=128KiB
#GELF_CONVERT_KEEP_RAW=malformed
#GELF_CONVERT_ACCEPT_MALFORMED=true

# -------------------------------------------------------------------- memoria
# O GOMEMLIMIT precisa ser pelo menos o dobro de GELF_RING_MAX_BYTES, e o
# limite do container fica acima dele. Gramaticas diferentes: MEMORY_LIMIT e'
# do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
#GELF_GOMEMLIMIT=512MiB
#GELF_MEMORY_LIMIT=768M
#GELF_RING_MAX_BYTES=256MiB
#GELF_RING_CAPACITY_ITEMS=65536
#GELF_RING_HIGH_WATER=0.80

# ------------------------------------------------------------------------- UDP
# O teto real e' net.core.rmem_max do HOST (sysctl -w net.core.rmem_max=16777216).
#GELF_LISTEN_UDP_READ_BUFFER=8MiB
#GELF_LISTEN_UDP_LISTENERS=1
#GELF_LISTEN_UDP_REASSEMBLY_MAX_BYTES=64MiB

# ------------------------------------------------------------------ PostgreSQL
# Valem para o servidor E para o servico postgres do compose, que cria o usuario
# com elas na primeira subida (depois disso, so' recriando o volume).
#GELF_SINK_POSTGRES_USERNAME=gelf
#GELF_SINK_POSTGRES_PASSWORD=gelf
#GELF_SINK_POSTGRES_DATABASE=gelf
# A fila LogHub (SPEC §3.7.1); docker/postgres/inbox.sql a cria na primeira subida.
#GELF_SINK_POSTGRES_TABLE=loghub.inbox
#GELF_SINK_WORKERS=4
# 0 deriva sink.workers + 1.
#GELF_SINK_POSTGRES_POOL_SIZE=0

# ---------------------------------------------------------------- eventbus
# A URL do eventbus LogHub (SPEC §10.9), no lugar das chaves de conexao: so'
# postgres:// ou postgresql://. So' chega ao container depois de editar o
# docker-compose.yml: apagar as quatro linhas de conexao marcadas e descomentar
# a LOGHUB_EB_URL. Usuario e senha vao DENTRO da URL, e as chaves donas
# (GELF_SINK_POSTGRES_ADDR/USERNAME/PASSWORD/DATABASE) nao podem estar
# definidas junto: o boot sai com 1.
# SEM TLS: sslmode=require, verify-ca e verify-full sao exit 1 (o servidor
# sempre conecta com sslmode=disable). Omita o sslmode, ou use disable.
#LOGHUB_EB_URL=postgres://gelf:gelf@postgres:5432/gelf

# ---------------------------------------------------------------- desligamento
# Aumentou? Aumente stop_grace_period em common.yml (precisa ser maior que a soma).
#GELF_SHUTDOWN_PRE_STOP_DELAY=0s
#GELF_SHUTDOWN_DRAIN_TIMEOUT=30s

# ---------------------------------------------------------------- demonstracao
# compose.demo.yml (perfil "demo"): o fluent-bit que emite GELF.
#GELF_FLUENT_BIT_IMAGE=fluent/fluent-bit:4.1.1
#GELF_DEMO_INTERVAL=5
