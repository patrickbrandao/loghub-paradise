# Copie para .env e ajuste. O Compose le' .env a partir do diretorio do primeiro
# arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem default embutido no compose.
#
# So' chaves que exigem restart passam por aqui (env vence o INI e nao muda num
# container de pe'). As RECARREGAVEIS -- log.level, log.access,
# log.access_sample -- ficam em conf/syslog.ini: edite o arquivo e mande
# `docker kill -s HUP slpg`.
#
# Variaveis do go-syslog-server que este servidor nao tem (SYSLOG_LISTEN_TLS,
# SYSLOG_TLS_*, SYSLOG_FILTER_*, SYSLOG_RATELIMIT_*, SYSLOG_SINK_TYPE,
# SYSLOG_RING_MODE, as de nats/redis/sqlite/mysql/clickhouse,
# LOGHUB_BEACON_INTERVAL...) nao fazem nada aqui; se chegarem ao container, o
# boot as nomeia num WARN. Elas nem chegam: o compose so' repassa as abaixo.

# ---------------------------------------------------------------- build/imagem
SYSLOG_IMAGE=go-syslog-pg-server
SYSLOG_IMAGE_TAG=local
SYSLOG_VERSION=dev
SYSLOG_COMMIT=none
SYSLOG_GO_VERSION=1.25
SYSLOG_ALPINE_VERSION=3.22
SYSLOG_POSTGRES_IMAGE=postgres:18-alpine

# ------------------------------------------------------------------ identidade
# O tenant LogHub: vira o `space` de todo envelope (coluna space da fila).
# NAO e' o ambiente. Gramatica: segmentos de [a-z0-9-] separados por ponto, ate
# 64 caracteres. Fora de [a-z0-9.-] o go-loghub-ident sai com 111; um segmento
# vazio (a..b, .x, x.) passa na biblioteca e o servidor sai com 1 (README,
# "Identidade"). O compose le SYSLOG_WORKSPACE, nunca o WORKSPACE do shell: o
# Jenkins exporta WORKSPACE com o caminho do job, e ele viraria o space (111).
#SYSLOG_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Defaults distintos dos compose do go-syslog-server, para os dois rodarem no
# mesmo host. Para receber na porta padrao do syslog, use SYSLOG_PORT=514.
#SYSLOG_PORT=5180
#SYSLOG_ADMIN_PORT=19180
#SYSLOG_POSTGRES_PORT=15480

# -------------------------------------------------------------- PROXY protocol
# So' no TCP, com um balanceador (ou terminador TLS) na frente.
#SYSLOG_PROXY_PROTOCOL=optional
#SYSLOG_PROXY_TRUSTED=10.0.0.0/8

# ------------------------------------------------------------------- conversao
# Exigem restart (SPEC §16.3). Nomes fixados pela skill loghub-type-syslog-schema.
#SYSLOG_MAX_MESSAGE_BYTES=64KiB
#SYSLOG_RFC3164_TIMEZONE=America/Sao_Paulo
#SYSLOG_PAYLOAD_RAW=true
#SYSLOG_LEGACY_CHARSET=cp1252
#SYSLOG_ACCEPT_MALFORMED=true
#SYSLOG_DEFAULT_PRIORITY=13
#SYSLOG_SD_MAX_ELEMENTS=32
#SYSLOG_SD_MAX_PARAMS=64

# -------------------------------------------------------------------- memoria
# O GOMEMLIMIT precisa ser pelo menos o dobro de SYSLOG_RING_MAX_BYTES, e o
# limite do container fica acima dele. Gramaticas diferentes: MEMORY_LIMIT e'
# do Compose (768M); GOMEMLIMIT e' do Go (512MiB).
#SYSLOG_GOMEMLIMIT=512MiB
#SYSLOG_MEMORY_LIMIT=768M
#SYSLOG_RING_MAX_BYTES=256MiB
#SYSLOG_RING_CAPACITY_ITEMS=65536
#SYSLOG_RING_HIGH_WATER=0.80

# ------------------------------------------------------------------------- UDP
# O teto real e' net.core.rmem_max do HOST (sysctl -w net.core.rmem_max=16777216).
#SYSLOG_LISTEN_UDP_READ_BUFFER=8MiB
#SYSLOG_LISTEN_UDP_LISTENERS=1

# ------------------------------------------------------------------ PostgreSQL
# Valem para o servidor E para o servico postgres do compose, que cria o usuario
# com elas na primeira subida (depois disso, so' recriando o volume).
#SYSLOG_SINK_POSTGRES_USERNAME=syslog
#SYSLOG_SINK_POSTGRES_PASSWORD=syslog
#SYSLOG_SINK_POSTGRES_DATABASE=syslog
# A fila LogHub (SPEC §3.7.1); docker/postgres/inbox.sql a cria na primeira subida.
#SYSLOG_SINK_POSTGRES_TABLE=loghub.inbox
#SYSLOG_SINK_WORKERS=4
# 0 deriva sink.workers + 1.
#SYSLOG_SINK_POSTGRES_POOL_SIZE=0

# ---------------------------------------------------------------- eventbus
# A URL do eventbus LogHub (SPEC §10.9), no lugar das chaves de conexao: so'
# postgres:// ou postgresql://. So' chega ao container depois de editar o
# docker-compose.yml: apagar as quatro linhas de conexao marcadas e descomentar
# a LOGHUB_EB_URL (README). Usuario e senha vao DENTRO da URL, e as chaves donas
# (SYSLOG_SINK_POSTGRES_ADDR/USERNAME/PASSWORD/DATABASE) nao podem estar
# definidas junto: o boot sai com 1.
# SEM TLS: sslmode=require, verify-ca e verify-full sao exit 1 (o servidor
# sempre conecta com sslmode=disable). Omita o sslmode, ou use disable.
#LOGHUB_EB_URL=postgres://syslog:syslog@postgres:5432/syslog

# ---------------------------------------------------------------- desligamento
# Aumentou? Aumente stop_grace_period em common.yml (precisa ser maior que a soma).
#SYSLOG_SHUTDOWN_PRE_STOP_DELAY=0s
#SYSLOG_SHUTDOWN_DRAIN_TIMEOUT=30s
