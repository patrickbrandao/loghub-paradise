# Copie para .env e ajuste. O Compose le' .env automaticamente a partir do
# diretorio do primeiro arquivo -f, ou seja, desta pasta.
#
#   cp .env.example .env
#
# Nada aqui e' obrigatorio: todo valor tem um default embutido no compose.

# ---------------------------------------------------------------- build/imagem
WHS_IMAGE=go-webhook-server
WHS_IMAGE_TAG=local
WHS_VERSION=dev
WHS_COMMIT=none
WHS_GO_VERSION=1.25
WHS_ALPINE_VERSION=3.22
WHS_REDIS_IMAGE=redis:7.4-alpine
# 18: a fila loghub.inbox da skill usa lz4 e o diretorio de dados da imagem 18
# (/var/lib/postgresql, que os compose montam). Volume de uma 17 nao sobe nela.
WHS_POSTGRES_IMAGE=postgres:18-alpine
WHS_MYSQL_IMAGE=mysql:8.4
WHS_NATS_IMAGE=nats:2.11-alpine
# 25.8+: o INSERT usa json_type_escape_dots_in_keys, e o boot confere a versao.
WHS_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
WHS_NATS_BOX_IMAGE=natsio/nats-box:latest

# ---------------------------------------------------------------- identidade
# O tenant LogHub: vira o `space` de todo envelope e o subject/stream
# loghub.<space>.webhook.request. Nao e' a variavel WORKSPACE do shell (o
# Jenkins exporta WORKSPACE=/var/lib/jenkins/... e o go-loghub-ident sairia com
# 111): o compose so' le WHS_WORKSPACE.
#WHS_WORKSPACE=default

# ------------------------------------------------------------------ exposicao
# Porta HTTP publicada no host. Cada compose tem um default distinto para que
# varias combinacoes possam rodar lado a lado; descomente para fixar.
#WHS_HTTP_PORT=8080
# Porta admin -- sempre publicada apenas em 127.0.0.1 do host.
#WHS_ADMIN_PORT=9101
#WHS_REDIS_PORT=6379
#WHS_POSTGRES_PORT=5432
#WHS_MYSQL_PORT=3306
#WHS_NATS_PORT=4222
# Protocolo nativo do ClickHouse (9000 dentro do conteiner).
#WHS_CLICKHOUSE_PORT=9000

# ----------------------------------------------------------------------- dados
# Nao existe knob de diretorio de dados aqui, de proposito. /data e' a unica
# area gravavel do container -- regra de TODA imagem do loghub-paradise, veja
# docs/SPEC.md 13.6 -- e common.yml fixa WHS_RING_DATA_DIR=/data literal, sem
# substituicao. Para os dados irem parar em outro lugar do host, troque o
# VOLUME no compose da combinacao; o caminho DENTRO do container nao muda.

# -------------------------------------------------------------------- memoria
# SPEC 12.4: sem GOMEMLIMIT o GC do Go nao sabe do teto do container e o OOM
# killer chega antes do GC. common.yml define os dois; o limite do container
# precisa ficar ACIMA do GOMEMLIMIT, e com ring=memory o GOMEMLIMIT precisa ser
# pelo menos o dobro de WHS_RING_MAX_BYTES (256MiB nos compose de memoria).
# Suba os tres juntos. Gramaticas diferentes: MEMORY_LIMIT e' do Compose (768M);
# GOMEMLIMIT e' do Go e aceita so' inteiro com B/KiB/MiB/GiB/TiB (maiusculas
# importam) ou off -- 768M derruba o processo antes do boot.
#WHS_GOMEMLIMIT=512MiB
#WHS_MEMORY_LIMIT=768M
#WHS_RING_MAX_BYTES=256MiB

# ---------------------------------------------------------------------- proxy
# TODO deploy atras de proxy/ingress PRECISA declarar os CIDRs dele aqui. Sem
# isso o servidor ignora X-Forwarded-For e enxerga o IP do proxy como cliente,
# o que quebra rate limit, exempt e o network.ip.src do envelope.
#WHS_PROXY_TRUSTED=127.0.0.0/8,::1,10.0.0.0/8

# ----------------------------------------------------------------- rate limit
# Ligue SOMENTE depois de WHS_PROXY_TRUSTED estar correto: um limitador com
# proxy.trusted errado agrupa o mundo inteiro num balde so' e vira auto-DoS.
#WHS_RATELIMIT_ENABLED=true
#WHS_RATELIMIT_RATE=100
#WHS_RATELIMIT_BURST=200

# ---------------------------------------------------------------------- redis
#WHS_SINK_REDIS_STREAM=loghub.{space}.{type}
#WHS_SINK_REDIS_DB=0
#WHS_SINK_REDIS_USERNAME=
#WHS_SINK_REDIS_PASSWORD=

# ------------------------------------------------------------------- postgres
# Os tres compose.*-postgres.yml usam estes valores nos DOIS lados: para criar o
# banco na imagem oficial e para o webhook se conectar. A senha padrao "webhook"
# e' de desenvolvimento; em producao, defina aqui.
#WHS_SINK_POSTGRES_USERNAME=webhook
#WHS_SINK_POSTGRES_PASSWORD=webhook
#WHS_SINK_POSTGRES_DATABASE=webhook
#WHS_SINK_POSTGRES_TABLE=loghub.inbox
# 0 deriva sink.workers + 1. Cada worker e' uma conexao no servidor.
#WHS_SINK_POSTGRES_POOL_SIZE=0
# Contra um banco fora do compose (gerenciado em nuvem), ligue e monte a CA em
# /etc/webhook, somente leitura.
#WHS_SINK_POSTGRES_TLS=false
#WHS_SINK_POSTGRES_TLS_CA=

# ---------------------------------------------------------------------- mysql
# Os tres compose.*-mysql.yml usam estes valores nos DOIS lados: para criar o
# banco na imagem oficial e para o webhook se conectar. Senhas padrao de
# desenvolvimento; em producao, defina aqui.
#WHS_MYSQL_ROOT_PASSWORD=root
#WHS_SINK_MYSQL_USERNAME=webhook
#WHS_SINK_MYSQL_PASSWORD=webhook
#WHS_SINK_MYSQL_DATABASE=webhook
#WHS_SINK_MYSQL_TABLE=inbox
# 0 deriva sink.workers + 1. Cada worker e' uma conexao no servidor.
#WHS_SINK_MYSQL_POOL_SIZE=0
#WHS_SINK_MYSQL_TLS=false
#WHS_SINK_MYSQL_TLS_CA=

# ----------------------------------------------------------------- clickhouse
# Os tres compose.*-clickhouse.yml usam estes valores nos DOIS lados: para a
# imagem oficial criar o banco e o usuario, e para o webhook se conectar.
# Senhas padrao de desenvolvimento; em producao, defina aqui. O usuario precisa
# so' de INSERT na tabela e de um perfil com readonly = 0. async_insert e
# wait_for_async_insert sao do perfil do usuario no ClickHouse, nao daqui
# (docs/SPEC.md 8.8.6).
#WHS_SINK_CLICKHOUSE_USERNAME=webhook
#WHS_SINK_CLICKHOUSE_PASSWORD=webhook
#WHS_SINK_CLICKHOUSE_DATABASE=webhook
# A tabela de clickhouse/inbox.sql, com os hints Map do payload webhook. Trocar
# o nome aqui NAO muda o DDL nem o healthcheck do compose (os dois usam inbox):
# crie a tabela a mao com o nome novo, ou o servidor sai com 3.
#WHS_SINK_CLICKHOUSE_TABLE=inbox
# 0 deriva sink.workers + 1. Cada worker e' uma conexao e um INSERT por vez.
#WHS_SINK_CLICKHOUSE_POOL_SIZE=0
# Com TLS o endereco costuma ser a porta 9440.
#WHS_SINK_CLICKHOUSE_TLS=false
#WHS_SINK_CLICKHOUSE_TLS_CA=

# ----------------------------------------------------------------------- nats
# Se trocar o nome do stream, edite tambem os subjects em nats/stream.json: o
# webhook exige que o subject pertenca ao stream configurado e sai com 3 se
# nao pertencer.
#WHS_SINK_NATS_STREAM=LOGHUB_WEBHOOK_REQUEST
#WHS_SINK_NATS_SUBJECT=loghub.{space}.{type}
#WHS_SINK_NATS_USERNAME=
#WHS_SINK_NATS_PASSWORD=
# Contra um NATS gerenciado: monte o .creds em /etc/webhook e aponte aqui.
#WHS_SINK_NATS_CREDENTIALS=
#WHS_SINK_NATS_TLS=false
#WHS_SINK_NATS_TLS_CA=

# ------------------------------------------------------------------ servidor
#WHS_SERVER_LISTENERS=1
#WHS_SERVER_MAX_BODY_BYTES=5MiB
#WHS_LOG_LEVEL=info
#WHS_LOG_FORMAT=json
#WHS_LOG_ACCESS=false

# ---------------------------------------------------------------- desligamento
# Atras de um balanceador, pre_stop_delay mantem o servidor respondendo depois
# do SIGTERM pelo tempo que o LB leva para tirar o endpoint da rotacao.
# Se aumentar isto ou o drain_timeout, aumente stop_grace_period em common.yml.
#WHS_SHUTDOWN_PRE_STOP_DELAY=0s
#WHS_SHUTDOWN_DRAIN_TIMEOUT=30s
